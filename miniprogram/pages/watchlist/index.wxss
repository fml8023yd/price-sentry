.page { padding: 24rpx; }
.add-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.url-input { flex: 1; background: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.add-btn { background: #e94560; color: #fff; border-radius: 12rpx; font-size: 30rpx; padding: 0 32rpx; }
.empty { color: #999; text-align: center; margin-top: 120rpx; font-size: 28rpx; }
.card { display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; align-items: center; }
.thumb { width: 120rpx; height: 120rpx; border-radius: 8rpx; background: #eee; }
.meta { flex: 1; margin-left: 20rpx; }
.title { font-size: 28rpx; color: #333; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.price-row { margin-top: 8rpx; }
.price { color: #e94560; font-size: 36rpx; font-weight: 600; }
.trend { margin-left: 16rpx; font-size: 24rpx; }
.trend.down { color: #07c160; }
.trend.up { color: #ee0a24; }
.target { margin-top: 4rpx; font-size: 24rpx; color: #888; }
.remove { width: 60rpx; text-align: center; color: #ccc; font-size: 40rpx; }
