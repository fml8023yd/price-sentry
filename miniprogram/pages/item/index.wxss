.page { padding: 32rpx; }
.title { font-size: 30rpx; color: #333; }
.price { font-size: 56rpx; color: #e94560; font-weight: 700; margin: 16rpx 0; }
.stats { display: flex; gap: 24rpx; color: #888; font-size: 24rpx; margin-bottom: 24rpx; }
.curve { width: 640rpx; height: 320rpx; background: #fff; border-radius: 12rpx; }
.target-bar { display: flex; gap: 16rpx; margin-top: 32rpx; }
.target-input { flex: 1; background: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.set-btn { background: #07c160; color: #fff; border-radius: 12rpx; font-size: 28rpx; padding: 0 28rpx; }
