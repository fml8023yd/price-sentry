<view class="page" wx:if="{{item}}">
  <view class="title">{{item.title}}</view>
  <view class="price">¥{{item.latest_price}}</view>

  <view class="stats" wx:if="{{stats}}">
    <text>史低 ¥{{stats.min}}</text>
    <text>史高 ¥{{stats.max}}</text>
    <text>均价 ¥{{stats.avg}}</text>
  </view>

  <canvas canvas-id="priceCurve" class="curve"></canvas>

  <view class="target-bar">
    <input class="target-input" type="digit" placeholder="设个目标价" value="{{targetPrice}}" bindinput="onTargetInput" />
    <button class="set-btn" bindtap="onSetTarget">订阅降价提醒</button>
  </view>
</view>
